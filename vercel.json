{
  "buildCommand": "echo 'No build step; API only'",
  "installCommand": "npm ci",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/schemas", "destination": "/api/public/schemas" },
    { "source": "/schemas/:id", "destination": "/api/public/schemas/:id" },
    { "source": "/api/.well-known/jwks.json", "destination": "/api/jwks" },
    { "source": "/.well-known/jwks.json", "destination": "/api/jwks" }
  ],
  "functions": {
    "api/**/*.ts": {
      "memory": 256,
      "maxDuration": 10
    }
  }
}
